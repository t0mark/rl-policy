<mujoco model="terrain_render">
  <option timestep="0.01" gravity="0 0 -9.81"/>
  <default>
    <!-- terrain boxes default colour (brownish dirt) -->
    <geom rgba="0.62 0.52 0.40 1"/>
  </default>
  <visual>
    <global offwidth="1600" offheight="1200"/>
    <headlight diffuse="0.4 0.4 0.4" ambient="0.25 0.25 0.25" specular="0.0 0.0 0.0"/>
    <rgba haze="0.18 0.28 0.38 1"/>
    <quality shadowsize="2048"/>
  </visual>
  <worldbody>
    <!-- key light from above-front -->
    <light name="sun" pos="4 -4 15" dir="-1 1 -3"
           diffuse="0.90 0.85 0.70" specular="0.15 0.15 0.10" castshadow="true"/>
    <!-- fill light from opposite side -->
    <light name="fill" pos="-4 4 10" dir="1 -1 -2"
           diffuse="0.35 0.45 0.55" specular="0.0 0.0 0.0" castshadow="false"/>
    <!-- ground plane (overrides default geom colour) -->
    <geom name="floor" type="plane" size="30 30 0.1" pos="0 0 -0.05"
          rgba="0.76 0.82 0.72 1" contype="1" conaffinity="1"/>
  </worldbody>
  <asset/>
</mujoco>
